# Pokies

# Function to check for matches
def check_line(row):

    # Check for match
    if row[0] == row[1] and row[1] == row[2]:
        return True

    return False

# Introduction
print("Welcome to the slots machine!")

# Get randomiser
import random
score = 0

# Create symbols list
symbols = ["𝟕", "💲", "🍒", "♤"]

# Generate Grid
grid = []

# Run program until user stops
keep_going = True
while keep_going == True:

    # Reset each loop
    grid = []
    score = 0
    
# Row runs 3 times
    for row in range(3):
        row_list = []

# Every column choose random symbol and add to row
        for column in range(3):
            item = random.choice(symbols)
            row_list.append(item)
        
# Add new row to grid
        grid.append(row_list)

# Body
# Print a top border
    print("--- SLOTS ---")

# Every grid print on new line
    for row in grid:
        print(" | ".join(row))
    print("-------------")

    if check_line(row) == True:
        score +=1

#Final scores
    if score == 0:
        print("womp womp.. Sorry you didn't win anything.")

    elif score == 1:
        print("KACHING! YOU MADE 1 MATCH!")

    else:
        print("KACHING! YOU MADE {} MATCHES!".format(score))

    # Ask user if they want to continue
    valid_input =  False
