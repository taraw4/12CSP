# Pokies

# Import randomiser
import random

# Function to check for matches
def check_line(row_to_check):
    """Check if any any matches"""

    #Check for matches across rows
    return row_to_check[0] == row_to_check[1] == row_to_check[2]

# Function to create 3x3 grid
def generate_grid(symbols):
    """Generates and returns 3x3 list of lists"""
    grid = []

    # Row runs 3 times
    for _ in range(3): # HAD AI HELP WITH THIS!!!

        # Each column choose random symbol and add to row
        row_list = [random.choice(symbols) for _ in range(3)]

        # Add new row to grid
        grid.append(row_list)
    return grid

# Function to print grid and calculate matches
def play_round(symbols):
    """Plays one round, prints grid and returns matches"""
    grid = generate_grid(symbols)
    matches = 0
    
    # Print top border
    print("\n--- SLOTS ---")

    # Print every grid on a new line
    for row in grid:
        print(" | ".join(row))

        # Check each row as it's printed
        if check_line(row):
            matches += 1

    # Print bottom border
    print("-------------")

    return matches

# Function to handle user's choice to play again
def ask_to_play():
    """Handles user input and returns a boolean"""

    # Ask user if they want to continue
    while True:
        answer = input("Would you like to play again? (yes/no): ").lower().strip()

        if answer == "yes":
            return True

        elif answer == "no":
            return False

        # If unaccepted value entered
        print("Please enter a valid statement.")

# Function to check for whales
def check_marketing_status(profile):
    """Checks losses and updates marketing status"""
    whale_threshold = 500

    # Check lifetime_losses in dictionary
    if profile["lifetime_losses"] >= whale_threshold:

        #Print VIP message
        print("*SPECIAL VIP OFFER: Double your next deposit! Buy more credits now!*")

        # Updates new dictionary key
        profile["target_ads"] = True

    # Standard message
    else:
        print("Keep playing to climb the leaderboard!")
         

# Function to run program
def main():
    """The start point of the program"""

    # Introduction
    print("Welcome to the slots machine!")

    # Every spin costs 1.50 credits to track lifetime_losses
    spin_cost = 10.00

    # Get player information
    user_name = input("Enter username: ")
    user_location = input("Enter region (e.g Wellington): ")

    # Create starting budget
    balance = 20.00
    print("You have a starting gift of ${:.2f}".format(balance))

    # Ask if player would like to add more (Had AI help on this loop)
    while True:
        extra_funds = input("Would you like to add more? (Please type amount or 0)")

        try:
            added_amount = float(extra_funds)
            
            # Check number is not negative
            if added_amount >= 0:
                balance += (added_amount)
                break

            # If negative number
            else:
                print("Error: You cannot add a negative amount of money. Please try again.")

        # If user types text or symbols
        except ValueError:
            print("Invalid input! Please enter a number (e.g, 50 or 0.)")
            
    # Balance summary
    print("Your balance is now ${:.2f}".format(balance))
    print("Each spin costs ${:.2f}".format(spin_cost))

    # Create Player Profile Dictionary
    player_profile = {
        "username": user_name,
        "location": user_location,
        "balance": balance,
        "high_score": balance,
        "lifetime_losses": 0.0
        }

    # Create symbols list
    symbols = ["7", "$", "*", "#"]

    # Run program until user stops
    keep_going = True

    while keep_going:

        # Check if player has enough
        if player_profile["balance"] < spin_cost:
            print("Insufficient funds! Your balance is only ${:.2f}".format(player_profile["balance"]))
            break

        # Remove cost
        player_profile["balance"] -= spin_cost
        player_profile["lifetime_losses"] += spin_cost

        # Update matches this spin
        matches_this_spin = play_round(symbols)

        # Calculate money earned for this spin
        winnings = matches_this_spin * 20.00

        # Update Player Profile
        player_profile["balance"] += winnings

        # Update High Score if current run is better
        if player_profile["balance"] > player_profile["high_score"]:
            player_profile["high_score"] = player_profile["balance"]

        # Report round results
        if matches_this_spin > 0:
            print("KACHING! You earned ${:.2f}".format(winnings))

        else:
            print("womp womp... no matches this time.")
            
        
        # Print current balance
        print("--- CURRENT BALANCE : ${:.2f} ---".format(player_profile["balance"]))
        
        # Checks if program continues
        keep_going = ask_to_play()

    # Call new marketing function
    check_marketing_status(player_profile)
        
    # Final Report
    print("\n--- PLAYER SUMMARY ---")
    print("Player: {}".format(player_profile["username"]))
    print("Location: {}".format(player_profile["location"]))
    print("High Score: ${:.2f}".format(player_profile["high_score"]))
    print("Total Amount lost: ${:.2f}".format(player_profile["lifetime_losses"]))


    print("------------------------")
    print("Thanks for playing!")

# Calls the main function to start the game
if __name__ == "__main__":
    main()

