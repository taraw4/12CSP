# Pokies

# Import randomiser
import random
score = 0

# Function to check for matches
def check_line(row_to_check):
    """Check if any any matches"""

    #Check for matches across rows
    return row_to_check[0] == row_to_check[1] == row_to_check[2]

# Function to create 3x3 grid
def generate_grid(symbols):
    """Generates and returns 3x3 list of lists"""
    grid = []

    # Row runs 3 times
    for _ in range(3):

        # Each column choose random symbol and add to row
        row_list = [random.choice(symbols) for _ in range(3)]

        # Add new row to grid
        grid.append(row_list)
    return grid

# Function to print grid and calculate matches
def play_round(symbols):
    """Plays one round, prints grid and returns matches"""
    grid = generate_grid(symbols)
    matches = 0
    
    # Print top border
    print("\n--- SLOTS ---")

    # Print every grid on a new line
    for row in grid:
        print(" | ".join(row))

        # Check each row as it's printed
        if check_line(row):
            matches += 1

    # Print bottom border
    print("-------------")

    return matches

# Function to handle user's choice to play again
def ask_to_play():
    """Handles user input and returns a boolean"""

    # Ask user if they want to continue
    while True:
        answer = input("Would you like to play again? (yes/no): ").lower().strip()

        if answer == "yes":
            return True

        elif answer == "no":
            return False

        # If unaccepted value entered
        print("Please enter a valid statement.")

# Function to run program
def main():
    """The entry point to begin"""

    # Introduction
    print("Welcome to the slots machine!")

    # Create Player Profile Dictionary
    player_profile = {
        "username": "",
        "location": "",
        "high_score": 0,
        "lifetime_losses": 0.0
        }

    # Ask for player information
    player_profile["username"] = input("Enter username: ")
    player_profile["location"] = input("Enter region (e.g Wellington): ")

    # Create symbols list
    symbols = ["7", "$", "*", "#"]

    # Total matches overall
    total_matches = 0

    # Run program until user stops
    keep_going = True

    while keep_going:

        # Every spin costs 1.50 credits to track lifetime_losses
        player_profile["lifetime_losses"] += 1.50

        # Update matches this spin
        matches_this_spin = play_round(symbols)

        # Update total matches overall
        total_matches += matches_this_spin

        # Update High Score if current run is better
        if total_matches > player_profile["high_score"]:
            player_profile["high_score"] = total_matches

        # Report round results
        if matches_this_spin == 0:

            print("womp womp... Sorry you didn't win anything.")
        elif matches_this_spin == 1:

            print("KACHING! You made 1 match!")
            
        else:
            print("KACHING! You made {} matches!".format(matches_this_spin))

        # Checks if program continues
        keep_going = ask_to_play()

    # Final Report
    print("\n--- PLAYER SUMMARY ---")
    print("Player: {} ".format["username"])
    print("Location: {}".format["location"])
    print("High Score: {}".format["high_score"])
    print("Total Amount lost: ${}".format["lifetime_losses"])
    print("------------------------")
    print("Thanks for playing!")

# Calls the main function to start the game
if __name__ == "__main__":
    main()
            

