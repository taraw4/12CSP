# Pokies

# Get randomiser
import random
score = 0

# Function to check for matches
def check_line(row_to_check):
    """Check if any any matches"""
    

    # Check for match
    if row_to_check[0] == row_to_check[1] == row_to_check[2]:
        return True

    return False

# Introduction
print("Welcome to the slots machine!")

# Create symbols list
symbols = ["7", "$", "*", "#"]

# Total matches overall
total_matches = 0

# Run program until user stops
keep_going = True
while keep_going == True:

    # Reset each loop
    grid = []
    matches_this_spin = 0

    # Row runs 3 times
    for row in range(3):
        row_list = []

        # Every column choose random symbol and add to row
        for column in range(3):
            item = random.choice(symbols)
            row_list.append(item)
        
        # Add new row to grid
        grid.append(row_list)

# Body

    # Print a top border
    print("\n--- SLOTS ---")

    # Every grid print on new line
    for row in grid:
        print(" | ".join(row))

        # Check each row as it's printed
        if check_line(row):
            matches_this_spin += 1

    # Print bottom border       
    print("-------------")
    
    # Update total score
    total_matches += matches_this_spin

    # Final scores for this round
    if matches_this_spin == 0:
        print("womp womp.. Sorry you didn't win anything.")

    elif matches_this_spin == 1:
        print("KACHING! YOU MADE 1 MATCH!")

    else:
        print("KACHING! YOU MADE {} MATCHES!".format(matches_this_spin))

    # Ask user if they want to continue
    valid_input =  False
    while not valid_input:
        answer = input("Would you like to play again? (yes/no): ").lower().strip

        if answer == "yes":
            keep_going = True
            valid_input = True

        elif answer == "no":
            keep_going = False
            valid_input = True

        else:
            print("Please enter a valid statement")
    
