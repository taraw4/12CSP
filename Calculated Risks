# Import random
import random

# Functions
def easy():
    return random.randint(1, 500)

def medium():
    return random.randint(1, 5000)


def hard():
    return random.randint(1,10000)


def main():
    """
    Main routine
    contains menu
    """

    # Greet user
    print("Welcome to Calculated Risks!")

    # Give user starting points
    points = 0

    # Create loop to display points + menu
    while True:
        # Print points
        print("\nPOINTS: {}".format(points))
        print("\n -- OPTION SELECT --")
        print("\n1.) EASY")
        print("2.) MEDIUM")
        print("3.) HARD")
        print("4.) END GAME")

        choice = input("\nPlease select an option. (e.g '1'): ")

        if choice == "1":
            number = easy()
            print("\nGenerated Easy Number: {}".format(number))

        elif choice == "2":
            number = medium()
            print("\nGenerated Medium Number: {}".format(number))

        elif choice == "3":
            number = hard()
            print("\nGenerated Hard Number: {}".format(number))

        elif choice == "4":
            break

        else:
            ("Please enter a valid number (e.g '1')")


# Run main program
if __name__ == "__main__":
    main()
