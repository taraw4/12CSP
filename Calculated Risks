    print("Medium High Score: {} Points".format(high_scores["Medium"]))
    print("Hard High Score:   {} Points".format(high_scores["Hard"]))
    print("--------------------------------------")
    

def display_end_game(difficulty, points, high_scores, max_streak, max_multiplier):
    """Displays game over message and stats summary including all high scores"""
    print("\n------------------------------------")
    print("         THANK YOU FOR PLAYING!       ")
    print("--------------------------------------")
    print("Round Score ({}):  {} Points".format(difficulty, points))
    print("--------------------------------------")
    print("Easy High Score:   {} Points".format(high_scores["Easy"]))
    print("Medium High Score: {} Points".format(high_scores["Medium"]))
    print("Hard High Score:   {} Points".format(high_scores["Hard"]))
    print("--------------------------------------")
    print("Longest Streak:    {}".format(max_streak))
    print("Max Multiplier:    {}x".format(max_multiplier))
    print("--------------------------------------")
    

