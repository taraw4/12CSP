# Import random
import random

# Functions
def generate_number(max_value):
    """Generates random number"""
    return random.randint(1, max_value)

def generate_values(symbols, max_value):
    """Generates two random numbers and a symbol"""
    num_1 = generate_number(max_value)
    num_2 = generate_number(max_value)
    symbol = random.choice(symbols)

    # Return values
    return num_1, symbol, num_2

def generate_problems(symbols, max_value, difficulty):
    """Plays one round, prints line and returns"""
    #Collect values from generate_values
    num_1, symbol, num_2 = generate_values(symbols, max_value)

    # Define correct_answer
    correct_answer = 0

    # Display problem
    print("\n{} Problem: {} {} {} = ? ".format(difficulty, num_1, symbol, num_2))

    # Calculate correct answer
    if symbol == "+":
        correct_answer = num_1 + num_2

    elif symbol == "-":
        correct_answer = num_1 - num_2

    elif symbol == "×":
        correct_answer = num_1 * num_2

    elif symbol == "÷":
        correct_answer = num_1 / num_2

    # Return answer
    return correct_answer

def main():
    """
    Main routine
    contains menu
    """

    # Greet user
    print("Welcome to Calculated Risks!")

    # Give user starting points
    points = 0

    # Create basic symbols list
    symbols = ["+", "-", "×", "÷"]


    # Create loop to display points + menu
    while True:
        # Print points
        print("\nPOINTS: {}".format(points))
        print("\n -- OPTION SELECT --")
        print("\n1.) EASY")
        print("2.) MEDIUM")
        print("3.) HARD")
        print("0.) END GAME")

        choice = input("\nPlease select an option. (e.g '1'): ")

        # Allow user to select option
        if choice == "1":
            difficulty = "Easy"

            # Store correct answer
            correct_answer = generate_problems(symbols, 10, difficulty)

            # Loop until user enters valid number
            while True:
                try:
                    # Make sure guess only takes float
                    guess = float(input("Answer: "))

                    # Exit loop if input is valid number
                    break

                except ValueError:
                    print("Invalid input! Please enter a number.")

            # Check if answer is correct
            if guess == correct_answer:
                print("Correct!")
                points += 1

            # If answer is incorrect
            else:
                print("Incorrect! The answer was {}".format(correct_answer))

        # If user chooses option 2
        elif choice == "2":
            difficulty = "Medium"

            # Store correct answer
            correct_answer = generate_problems(symbols, 100, difficulty)

            # Loop until user enters valid number
            while True:
                try:

                    # Make sure guess only takes float
                    guess = float(input("Answer: "))

                    # Exit loop if input is valid number
                    break

                except ValueError:
                    print("Invalid input! Please enter a number.")

            # Check if answer is correct
            if guess == correct_answer:
                print("Correct!")
                points += 1

            # If answer is incorrect
            else:
                print("Incorrect! The answer was {}".format(correct_answer))

        # if user chooses option 3
        elif choice == "3":
            difficulty = "Hard"

            # Store correct answer
            correct_answer = generate_problems(symbols, 1000, difficulty)

            # Loop until user enters valid number
            while True:
                try:

                    # Make sure guess only takes float
                    guess = float(input("Answer: "))

                    # Exit loop if input is valid number
                    break

                except ValueError:
                    print("Invalid input! Please enter a number.")

            # Check if answer is correct
            if guess == correct_answer:
                print("Correct!")
                points += 1

            # If answer is incorrect
            else:
                print("Incorrect! The answer was {}".format(correct_answer))


        # Allow user to exit program
        elif choice == "0":
            break

        # Make sure user chooses valid number
        else:
            print("Please enter a valid number (e.g '1')")


# Run main program
if __name__ == "__main__":
    main()


