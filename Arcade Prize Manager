# Functions

def display_all_inventory(data):
    """Print all inventory names (items) in the database"""
    print("\n--- Arcade Inventory ---")
    for toy in data:
        # Display inventory nicely
        print("Name: {} | Ticket Cost: {} | Current Stock: {} ".format(toy["name"],
              toy["ticket cost"], toy["current stock"]))

   
def add_tickets(balance):
    """Update players ticket balance"""

    # Ask player how many tickets they would like to add
    while True:
        extra_tickets = input("Please enter amount of tickets to add. (e.g 200): ")

        try:
            added_amount = int(extra_tickets)

            # Check number is not negative
            if added_amount >= 0:
                balance += added_amount
                break

            # If negative number
            else:
                print("\nError: You cannot add a negative amount of tickets. Please try again.")

        # If user types text or symbolss
        except ValueError:
            print("\nInvalid input! Please enter a number(e.g, 50 or 200.)")

    # If all good update balance
    print("\nSuccessfully updated. Your balance is now {} tickets.".format(balance))

    # If user has 2000 or more tickets
    if balance >= 2000:
        print("Congratulations! You are now a VIP member!")

    return balance
   
# Redeem prize
def redeem_prize(prizes_list, balance):
    """Allow player to redeem a prize if stock is available and they have enough tickets"""

   # Loop to ask until prize is found
    while True:
        prize_name = input("Enter the prize you want to redeem: ").title()

        # Track if match found
        prize_match = False

        # Search for the prize in the list
        for prize in prizes_list:
            if prize["name"] == prize_name:

                # Match to end loop
                prize_match = True

                # Check stock
                if prize["current stock"] <= 0:
                    print("\nSorry, {} is out of stock".format(prize_name))

                    # Stays the same
                    return balance
           

                # Check ticket balance
                elif balance < prize["ticket cost"]:
                    print("\nNot enough tickets. {} costs {} tickets".format(prize_name, prize['ticket cost']))

                    # Stays the same
                    return balance

                else:
                    actual_cost = prize['ticket cost']
           
                    # If VIP get 10% discount
                    if balance >= 2000:
                        actual_cost = int(prize["ticket cost"] * 0.9)
                        print("\nVIP discount applied! This prize only costs {} tickets instead of {}".format(actual_cost, prize['ticket cost']))
       
               
                    # If enough tickets + stock
                    balance -= actual_cost
                    prize["current stock"] -= 1

                    # Give update message
                    print("\nYou redeemed 1 {} for {} tickets!".format(prize_name, actual_cost))
                    print("Remaining balance: {} tickets".format(balance))
                    print("Current stock for {}: {}".format(prize_name, prize['current stock']))
                    return balance

        # If prize not found
        if prize_match == False:    
            print("\nPrize not found. Please check spelling and try again.")
                


def find_affordable_prizes(prizes_list, balance):
    """Shows player all prizes with less or equal value to the tickets they want to spend"""

    # Ask player how many tickets they would like to spend
    while True:

        try:
            budget = int(input("How many tickets do you want to spend?"))

            # Check number isn't negative
            if budget >= 0:
                break

            # If negative number
            else:
                print("\nError: You cannot add a negative amount of tickets. Please try again.")

        # If user types text or symbols     
        except ValueError:
            print("\nInvalid input! Please enter a number(e.g, 50 or 200.)")

    # Create a list of prizes the player can afford
    affordable_prizes = []

    # Loop through list of prizes
    for prize in prizes_list:
           
        # Check the price is either under or equal to players budget ans check balance is over 0
        if prize["ticket cost"] <= budget and prize["current stock"] > 0:

            # If meets requirments, add to affordable_prizes list
            affordable_prizes.append(prize)

    # Check the number of items in list is over 0:
    if len(affordable_prizes) > 0:

        # Print neatly
        print("\n--- Affordable Prizes ---")
        for prize in affordable_prizes:
            print("Name: {} | Ticket Cost: {} | Current Stock: {} ".format(prize["name"],
            prize["ticket cost"], prize["current stock"]))

    # If no prizes that match requirments
    else:
        print("\nKeep playing! No prizes are available for that amount yet.")

    return balance

def main():
    """
    Main routine
    contains  dictionary and menu
    """
   
    # Create list of dictionary
    # Store 5 different prizes
    prizes_list = [{"name": "Bouncy Ball", "ticket cost": 10, "current stock": 60},
                    {"name": "Fidget Spinner", "ticket cost": 30, "current stock": 52},
                    {"name": "Bop It", "ticket cost": 100, "current stock": 24},
                    {"name": "Action Figure", "ticket cost": 500, "current stock": 12},
                    {"name": "Nerf Gun", "ticket cost": 1000, "current stock": 5}]
               
    # Greet user
    print("Welcome to WGC's Mega-Byte Arcade!")

    # Give user a starting balance
    balance = 0
   
    print("You have {} tickets.".format(balance))

    # Create loop that stays open until user exits
    while True:
        # Print options
        print("\n-- User Menu ---")
        print("1.) Display Inventory")
        print("2.) Add Tickets")
        print("3.) Redeem Prize")
        print("4.) Find Affordable Prizes")
        print("0.) Exit")
   
        choice = input("Please select an option. (e.g '1'): ")

        # If user selects option 1: Display inventory
        if choice == "1":
            display_all_inventory(prizes_list)

        # Add tickets
        elif choice == "2":
            balance = add_tickets(balance)

        # Redeem prize
        elif choice == "3":
            balance = redeem_prize(prizes_list, balance)

        # Find affordable prizes
        elif choice == "4":
            balance = find_affordable_prizes(prizes_list, balance)
           
        # End program
        elif choice == "0":
            print("\nProgram shutting down...")
            print("Program terminated.")
            break

        # Invalid code entered
        else:
            print("Please enter a valid number")
   

# Run main program
if __name__ == "__main__":
    main()


