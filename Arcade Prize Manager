# Functions

def display_all_inventory(data):
    """Print all inventory names (items) in the database"""
    print("\n--- Arcade Inventory ---")
    for toy in data:
        # Display inventory nicely
        print("Name: {} | Ticket Cost: {} | Current Stock: {} ".format(toy["name"],
              toy["ticket cost"], toy["current stock"]))

    
def add_tickets(balance):
    """Update players ticket balance"""

    # Ask player how many tickets they would like to add
    while True:
        extra_tickets = input("Please enter amount of tickets to add. (e.g 200): ")

        try:
            added_amount = int(extra_tickets)

            # Check number is not negative
            if added_amount >= 0:
                balance += added_amount
                break

            # If negative number
            else:
                print("Error: You cannot add a negative amount of tickets. Please try again.")

        # If user types text or symbolss
        except ValueError:
            print("Invalid input! Please enter a number(e.g, 50 or 200.)")

    # If all good update balance
    print("\nSuccessfully updated. Your balance is now {} tickets.".format(balance))

    # If user has 2000 or more tickets
    if balance >= 2000:
        print("Congratulations! You are now a VIP member!")

    return balance
   
